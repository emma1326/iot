#include "esp_camera.h"
#include <WiFi.h>
#include <HTTPClient.h>
#include <TinyGPSPlus.h>
#include <HardwareSerial.h>

// ---------------- CAMERA PINS ----------------
#define PWDN_GPIO_NUM   -1
#define RESET_GPIO_NUM  -1
#define XCLK_GPIO_NUM   21
#define SIOD_GPIO_NUM   26
#define SIOC_GPIO_NUM   27

#define Y9_GPIO_NUM     35
#define Y8_GPIO_NUM     34
#define Y7_GPIO_NUM     39
#define Y6_GPIO_NUM     36
#define Y5_GPIO_NUM     19
#define Y4_GPIO_NUM     18
#define Y3_GPIO_NUM      5
#define Y2_GPIO_NUM      4

#define VSYNC_GPIO_NUM  25
#define HREF_GPIO_NUM   23
#define PCLK_GPIO_NUM   22

// ---------------- USER PINS ----------------
#define BUTTON_PIN      13
#define GPS_RX          14
#define GPS_TX          12

// ---------------- WIFI + SUPABASE ----------------
const char* WIFI_SSID = "process.env.WIFI_SSID";
const char* WIFI_PASSWORD = "process.env.WIFI_PASSWORD";

const char* SUPABASE_URL = "process.env.SUPABASE_URL";
const char* SUPABASE_KEY = "process.env.SUPABASE_KEY";

const char* BUCKET_NAME = "process.env.BUCKET_NAME";
const char* TABLE_NAME = "process.env.TABLE_NAME";

// ---------------- GPS ----------------
TinyGPSPlus gps;
HardwareSerial gpsSerial(1);

bool haveLastFix = false;
double lastLat = 0.0;
double lastLng = 0.0;
int lastSatellites = 0;
int lastDay = 0, lastMonth = 0, lastYear = 0;
int lastHour = 0, lastMinute = 0, lastSecond = 0;

// ---------------- CAMERA INIT ----------------
bool initCam() {
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer   = LEDC_TIMER_0;

  config.pin_d0       = Y2_GPIO_NUM;
  config.pin_d1       = Y3_GPIO_NUM;
  config.pin_d2       = Y4_GPIO_NUM;
  config.pin_d3       = Y5_GPIO_NUM;
  config.pin_d4       = Y6_GPIO_NUM;
  config.pin_d5       = Y7_GPIO_NUM;
  config.pin_d6       = Y8_GPIO_NUM;
  config.pin_d7       = Y9_GPIO_NUM;

  config.pin_xclk     = XCLK_GPIO_NUM;
  config.pin_pclk     = PCLK_GPIO_NUM;
  config.pin_vsync    = VSYNC_GPIO_NUM;
  config.pin_href     = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn     = PWDN_GPIO_NUM;
  config.pin_reset    = RESET_GPIO_NUM;

  config.xclk_freq_hz = 5000000;
  config.pixel_format = PIXFORMAT_JPEG;
  config.frame_size   = FRAMESIZE_QQVGA;
  config.jpeg_quality = 30;
  config.fb_count     = 1;
  config.fb_location  = CAMERA_FB_IN_DRAM;
  config.grab_mode    = CAMERA_GRAB_WHEN_EMPTY;

  esp_err_t err = esp_camera_init(&config);

  if (err != ESP_OK) {
    Serial.printf("Camera init failed: 0x%x\n", err);
    return false;
  }

  for (int i = 0; i < 3; i++) {
    camera_fb_t *fb = esp_camera_fb_get();
    if (fb) esp_camera_fb_return(fb);
    delay(100);
  }

  return true;
}

// ---------------- GPS HELPERS ----------------
void updateGPS() {
  while (gpsSerial.available()) {
    char c = gpsSerial.read();
    gps.encode(c);
  }

  if (gps.location.isValid() && gps.location.age() < 5000) {
    haveLastFix = true;
    lastLat = gps.location.lat();
    lastLng = gps.location.lng();
    lastSatellites = gps.satellites.isValid() ? gps.satellites.value() : 0;

    if (gps.date.isValid()) {
      lastDay = gps.date.day();
      lastMonth = gps.date.month();
      lastYear = gps.date.year();
    }

    if (gps.time.isValid()) {
      lastHour = gps.time.hour();
      lastMinute = gps.time.minute();
      lastSecond = gps.time.second();
    }
  }
}

void printTwoDigits(int value) {
  if (value < 10) Serial.print("0");
  Serial.print(value);
}

String twoDigitsString(int value) {
  if (value < 10) return "0" + String(value);
  return String(value);
}

void printCaptureInfo(camera_fb_t *fb) {
  Serial.printf("Photo OK: %u bytes, %ux%u\n", fb->len, fb->width, fb->height);

  if (haveLastFix) {
    Serial.print("Latitude: ");
    Serial.println(lastLat, 6);

    Serial.print("Longitude: ");
    Serial.println(lastLng, 6);

    Serial.println("Place: not resolved on device");

    Serial.print("Date: ");
    Serial.print(lastDay);
    Serial.print("/");
    Serial.print(lastMonth);
    Serial.print("/");
    Serial.println(lastYear);

    Serial.print("Time (UTC): ");
    printTwoDigits(lastHour);
    Serial.print(":");
    printTwoDigits(lastMinute);
    Serial.print(":");
    printTwoDigits(lastSecond);
    Serial.println();

    Serial.print("Satellites: ");
    Serial.println(lastSatellites);
  } else {
    Serial.println("Latitude: not available");
    Serial.println("Longitude: not available");
    Serial.println("Place: not resolved on device");
    Serial.println("Date: not available");
    Serial.println("Time (UTC): not available");
    Serial.println("Satellites: 0");
  }
}

// ---------------- SUPABASE HELPERS ----------------
String makeFileName() {
  if (haveLastFix) {
    return "snaplog_" +
           String(lastYear) + "-" +
           twoDigitsString(lastMonth) + "-" +
           twoDigitsString(lastDay) + "_" +
           twoDigitsString(lastHour) + "-" +
           twoDigitsString(lastMinute) + "-" +
           twoDigitsString(lastSecond) + ".jpg";
  }

  return "snaplog_" + String(millis()) + ".jpg";
}

String uploadPhotoToSupabase(camera_fb_t *fb, String fileName) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi not connected");
    return "";
  }

  HTTPClient http;

  String uploadUrl = String(SUPABASE_URL) +
                     "/storage/v1/object/" +
                     BUCKET_NAME + "/" +
                     fileName;

  http.begin(uploadUrl);
  http.addHeader("apikey", SUPABASE_KEY);
  http.addHeader("Authorization", "Bearer " + String(SUPABASE_KEY));
  http.addHeader("Content-Type", "image/jpeg");
  http.addHeader("x-upsert", "true");

  int httpCode = http.POST(fb->buf, fb->len);

  Serial.print("Photo upload HTTP code: ");
  Serial.println(httpCode);

  String response = http.getString();
  if (response.length() > 0) {
    Serial.println(response);
  }

  http.end();

  if (httpCode == 200 || httpCode == 201) {
    String publicUrl = String(SUPABASE_URL) +
                       "/storage/v1/object/public/" +
                       BUCKET_NAME + "/" +
                       fileName;
    return publicUrl;
  }

  return "";
}

void insertLogToSupabase(String imageUrl) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi not connected");
    return;
  }

  HTTPClient http;

  String insertUrl = String(SUPABASE_URL) +
                     "/rest/v1/" +
                     TABLE_NAME;

  String latText = haveLastFix ? String(lastLat, 6) : "not available";
  String lngText = haveLastFix ? String(lastLng, 6) : "not available";
  String dateText = haveLastFix ? String(lastDay) + "/" + String(lastMonth) + "/" + String(lastYear) : "not available";
  String timeText = haveLastFix ? twoDigitsString(lastHour) + ":" + twoDigitsString(lastMinute) + ":" + twoDigitsString(lastSecond) : "not available";
  int satellites = haveLastFix ? lastSatellites : 0;

  String json = "{";
  json += "\"image_url\":\"" + imageUrl + "\",";
  json += "\"latitude\":\"" + latText + "\",";
  json += "\"longitude\":\"" + lngText + "\",";
  json += "\"place\":\"not resolved on device\",";
  json += "\"date\":\"" + dateText + "\",";
  json += "\"time_utc\":\"" + timeText + "\",";
  json += "\"satellites\":" + String(satellites);
  json += "}";

  Serial.println("Sending JSON:");
  Serial.println(json);

  http.begin(insertUrl);
  http.addHeader("apikey", SUPABASE_KEY);
  http.addHeader("Authorization", "Bearer " + String(SUPABASE_KEY));
  http.addHeader("Content-Type", "application/json");
  http.addHeader("Prefer", "return=minimal");

  int httpCode = http.POST(json);

  Serial.print("Database insert HTTP code: ");
  Serial.println(httpCode);

  String response = http.getString();
  if (response.length() > 0) {
    Serial.println(response);
  }

  http.end();
}

// ---------------- SETUP ----------------
void setup() {
  Serial.begin(115200);
  delay(500);

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.print("WiFi connected. IP: ");
  Serial.println(WiFi.localIP());

  btStop();

  gpsSerial.begin(9600, SERIAL_8N1, GPS_RX, GPS_TX);

  if (!initCam()) {
    Serial.println("Init failed");
    while (1) delay(1000);
  }

  Serial.println("Ready. Press button.");
}

// ---------------- LOOP ----------------
void loop() {
  updateGPS();

  static bool lastButton = HIGH;
  bool nowButton = digitalRead(BUTTON_PIN);

  if (lastButton == HIGH && nowButton == LOW) {
    delay(30);

    if (digitalRead(BUTTON_PIN) == LOW) {
      Serial.println();
      Serial.println("Button pressed. Capturing...");

      updateGPS();

      camera_fb_t *fb = esp_camera_fb_get();

      if (!fb) {
        Serial.println("Capture failed");
      } else {
        printCaptureInfo(fb);

        String fileName = makeFileName();

        Serial.print("Uploading file: ");
        Serial.println(fileName);

        String imageUrl = uploadPhotoToSupabase(fb, fileName);

        if (imageUrl != "") {
          Serial.println("Image URL:");
          Serial.println(imageUrl);

          insertLogToSupabase(imageUrl);

          Serial.println("SnapLog saved to Supabase.");
        } else {
          Serial.println("Upload failed, database row not inserted.");
        }

        esp_camera_fb_return(fb);
      }

      while (digitalRead(BUTTON_PIN) == LOW) {
        updateGPS();
        delay(10);
      }
    }
  }

  lastButton = nowButton;
}
